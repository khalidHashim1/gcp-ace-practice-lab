DATA_MODE=local
# Optional absolute path to the separately delivered protected bank.
# Loaded as a local seed; admin saves take precedence. Never use NEXT_PUBLIC_.
QUESTION_BANK_PATH=
# For Next development, copy this file to apps/web/.env.local
# Local mode needs no cloud credentials and is forbidden in production.
# Cloud mode uses ADC locally or the Cloud Run runtime identity.
GOOGLE_CLOUD_PROJECT=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
